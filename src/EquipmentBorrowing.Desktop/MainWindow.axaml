<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:EquipmentBorrowing.Desktop.ViewModels"
        xmlns:views="using:EquipmentBorrowing.Desktop.Views"
        x:Class="EquipmentBorrowing.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Campus Equipment" Width="460" Height="780"
        WindowStartupLocation="CenterScreen">

    <Grid RowDefinitions="*, Auto">
        <ContentControl Grid.Row="0" Content="{Binding CurrentView}" Margin="12">
            <ContentControl.DataTemplates>
                <DataTemplate DataType="{x:Type vm:EquipmentViewModel}">
                    <views:EquipmentView/>
                </DataTemplate>
                <DataTemplate DataType="{x:Type vm:BorrowingsViewModel}">
                    <views:BorrowingsView/>
                </DataTemplate>
            </ContentControl.DataTemplates>
        </ContentControl>

        <Border Grid.Row="1" Background="#1E1E2C" Padding="6">
            <Grid ColumnDefinitions="*, *">
                <Button Grid.Column="0"
                        Content="Catalog, Checkout &amp; Mgmt"
                        Command="{Binding NavigateToEquipmentCommand}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Padding="12" Margin="3"
                        Foreground="White" Background="#33334C"/>
                <Button Grid.Column="1"
                        Content="Borrowings, Returns &amp; History"
                        Command="{Binding NavigateToBorrowingsCommand}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Padding="12" Margin="3"
                        Foreground="White" Background="#33334C"/>
            </Grid>
        </Border>
    </Grid>
</Window>