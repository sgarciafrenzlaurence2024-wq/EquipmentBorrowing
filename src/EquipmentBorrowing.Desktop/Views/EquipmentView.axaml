<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EquipmentBorrowing.Desktop.ViewModels"
             x:Class="EquipmentBorrowing.Desktop.Views.EquipmentView"
             x:DataType="vm:EquipmentViewModel">

    <ScrollViewer>
        <StackPanel Margin="15" Spacing="15">
            <TextBlock Text="Available Equipment" FontSize="22" FontWeight="Bold" />

            <ListBox ItemsSource="{Binding Equipments}" 
                     SelectedItem="{Binding SelectedEquipment}" 
                     Height="200" Background="#2B2B36" CornerRadius="8">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="5">
                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="16"/>
                            <TextBlock Text="{Binding IsAvailable, StringFormat='Available: {0}'}" FontSize="12" Foreground="#4CAF50"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Text="Select Student" FontWeight="SemiBold" Margin="0,10,0,0"/>
            <ComboBox ItemsSource="{Binding Students}" 
                      SelectedItem="{Binding SelectedStudent}" 
                      HorizontalAlignment="Stretch" Padding="10">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <TextBlock Text="Expected Return Date" FontWeight="SemiBold" Margin="0,10,0,0"/>
            <DatePicker SelectedDate="{Binding ExpectedReturnDate}" HorizontalAlignment="Stretch" />

            <Button Content="Borrow Equipment" 
                    Command="{Binding BorrowCommand}" 
                    HorizontalAlignment="Stretch" 
                    HorizontalContentAlignment="Center" 
                    Background="#007ACC" Foreground="White" 
                    Padding="15" Margin="0,20,0,0" CornerRadius="8"/>

            <TextBlock Text="{Binding StatusMessage}" 
                       Foreground="#FF5252" 
                       FontWeight="SemiBold" 
                       TextWrapping="Wrap" 
                       Margin="0,10,0,0"
                       HorizontalAlignment="Center"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>